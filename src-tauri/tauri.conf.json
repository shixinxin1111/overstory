{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overstory",
  "version": "1.2.0",
  "identifier": "app.overstory.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && sh scripts/build-cli.sh",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "binaries/overstory-cli": "cli/overstory-cli",
      "binaries/cli-manager.sh": "cli/cli-manager.sh",
      "../skills/overstory-entry/SKILL.md": "overstory-skill/SKILL.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "shortDescription": "你的桌面随身工作台",
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
